[mysqld]
# TR-DB-01, TR-DB-03
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'
transaction-isolation = READ-COMMITTED
sql-mode = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,ONLY_FULL_GROUP_BY

# Binary logs for point-in-time recovery: shipped off-site every 5 minutes by the backup service (NFR-REC-01).
log-bin = binlog
binlog-format = ROW
binlog-expire-logs-seconds = 691200
max-binlog-size = 64M
sync-binlog = 1
innodb-flush-log-at-trx-commit = 1

# Sized for a 4–8 GB VPS; raise innodb-buffer-pool-size to ~50% of RAM on bigger machines.
innodb-buffer-pool-size = 1G
max-connections = 300
