# Tanbeeh production settings for the VPS. Copy to .env (never commit it).

# Your domain. DNS: A records for DOMAIN and *.DOMAIN pointing at this server (AAAA too if you have IPv6).
DOMAIN=tanbeeh.app
ACME_EMAIL=ops@tanbeeh.app
APP_ENV=production

# Images built by CI (deploy workflow); leave REGISTRY=tanbeeh to build on the server instead.
REGISTRY=ghcr.io/your-github-user/tanbeeh
IMAGE_TAG=latest

# Databases, cache and storage: use long random values (scripts/init-secrets.sh prints letters-and-digits values,
# which these need: the Redis password goes inside a URL and the MinIO root password into mc's MC_HOST alias).
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# MinIO root (administrator): used only by the minio and minio-init services, never by the app or backups.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Application identity, created by minio-init: object get/put/delete and list on tanbeeh-assets and
# tanbeeh-exports only (M-11). Its access key is visible in signed export links; the secret key is not.
MINIO_APP_ACCESS_KEY=CHANGE_ME
MINIO_APP_SECRET_KEY=CHANGE_ME
# Backup identity, created by minio-init: read-only on tanbeeh-assets (L-30).
MINIO_BACKUP_ACCESS_KEY=CHANGE_ME
MINIO_BACKUP_SECRET_KEY=CHANGE_ME

# HMAC pepper for session and token hashes; changing it signs everyone out.
SESSION_PEPPER=CHANGE_ME

# Web Push (npx web-push generate-vapid-keys). Never rotate without a migration plan (TR-SEC-08).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@tanbeeh.app

# Email through any SMTP provider (TLS on 465 or STARTTLS on 587).
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM=Tanbeeh <no-reply@tanbeeh.app>

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FOODICS_CLIENT_ID=
FOODICS_CLIENT_SECRET=
FOODICS_WEBHOOK_SECRET=
SENTRY_DSN=
LOG_LEVEL=info

# Console IP allow-list (console Settings → console.ipAllowList). If a saved list locks everyone out, set
# CONSOLE_IP_POLICY=off, run `docker compose up -d api`, fix the list in the console, then set it back to enforce.
CONSOLE_IP_POLICY=enforce

# Behind an existing reverse proxy (nginx already on 80/443, deploy/README.md §8). Leave all five commented out when
# Caddy is the internet edge. The proxy terminates TLS and forwards every Tanbeeh host to 127.0.0.1:8480;
# 172.30.0.1 is the gateway of the `internal` network that the published port arrives through.
# CADDY_HTTP_PORT=127.0.0.1:8480
# CADDY_HTTPS_PORT=127.0.0.1:8443
# CADDY_SITE_ADDRESS=http://
# CADDY_TLS_MODE=off
# CADDY_TRUSTED_PROXIES=172.30.0.1/32
# TRUST_PROXY=172.30.0.10,172.30.0.1

# Off-site backups (backup/rclone.conf defines the remote). Use an upload-only key and a bucket with versioning /
# object lock; prune old backups from a separate trusted machine (deploy/README.md §5, M-14).
BACKUP_REMOTE=offsite:tanbeeh
BACKUP_RETENTION_DAYS=30
# true = this server also deletes off-site backups older than BACKUP_RETENTION_DAYS. Needs a delete-capable key on
# the VPS, which a compromised server could abuse; leave false unless you accept that.
BACKUP_PRUNE_ON_VPS=false
