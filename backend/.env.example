# Back-end environment (TRD appendix 30.6). Copy to .env for local development.
# The services in docker-compose.yml listen on 127.0.0.1 only (M-22), so keep 127.0.0.1 (not `localhost`, which may
# resolve to ::1) in the URLs below. These credentials are local-only; a shared environment needs its own.
NODE_ENV=development
APP_ENV=local
SERVICE_ROLE=api
PORT=4000
PLATFORM_DOMAIN=dop.localhost
DATABASE_URL=mysql://app_rw:app_rw@127.0.0.1:3306/dop
DATABASE_REPLICA_URL=mysql://app_rw:app_rw@127.0.0.1:3306/dop
DATABASE_MIGRATE_URL=mysql://root:root@127.0.0.1:3306/dop
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1
S3_BUCKET_ASSETS=dop-assets
S3_BUCKET_EXPORTS=dop-exports
# S3_ENDPOINT=http://127.0.0.1:9000   # uncomment with MinIO running (docker compose up minio); unset = local files
CDN_BASE_URL=http://127.0.0.1:9000/dop-assets
KMS_KEY_ID=local
# 32 bytes, base64. Local only: the KMS data key is replaced by this key outside AWS.
LOCAL_DATA_KEY=bG9jYWwtZGV2LWRhdGEta2V5LW5vdC1mb3ItcHJvZCE=
SESSION_PEPPER=local-dev-pepper-change-me-0123456789
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@dop.localhost
SES_REGION=me-central-1
EMAIL_FROM=no-reply@dop.localhost
SMTP_URL=smtp://127.0.0.1:1025
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
