{
  "openapi": "3.1.0",
  "info": {
    "title": "Tanbeeh Integration API",
    "version": "1.0.0",
    "description": "POS integration API. Rate limits: 10 requests/s per key (burst 20), 300/min per tenant."
  },
  "servers": [
    {
      "url": "https://api.tanbeeh.app"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "pk_live_… API key (TR-INT-03)"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "MFA_REQUIRED",
              "CSRF_FAILED",
              "FORBIDDEN",
              "TENANT_SUSPENDED",
              "TENANT_INACTIVE",
              "TRIAL_DAILY_LIMIT",
              "PLAN_LIMIT",
              "FEATURE_NOT_IN_PLAN",
              "EMAIL_NOT_VERIFIED",
              "NOT_FOUND",
              "INVITATION_EXPIRED",
              "PAIRING_CODE_INVALID",
              "SUPPORT_CODE_INVALID",
              "UPLOAD_INVALID",
              "CLAIM_INVALID",
              "IDEMPOTENCY_KEY_REUSED",
              "EXTERNAL_REF_IN_USE",
              "PLAN_DOWNGRADE_BLOCKED",
              "TICKET_VERSION_CONFLICT",
              "INVALID_TRANSITION",
              "CHECK_CODE_REQUIRED",
              "CHECK_CODE_INVALID",
              "REOPEN_WINDOW_PASSED",
              "NUMBERS_EXHAUSTED",
              "SLUG_TAKEN",
              "SLUG_RESERVED",
              "EMAIL_TAKEN",
              "IDEMPOTENCY_IN_PROGRESS",
              "PIN_LOCKED",
              "ACCOUNT_LOCKED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE",
              "MAINTENANCE"
            ]
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayNumber": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "preparing",
              "ready",
              "collected",
              "cancelled",
              "expired"
            ]
          },
          "version": {
            "type": "integer"
          },
          "seq": {
            "type": "integer"
          },
          "counterId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "waitMinutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "waitBaseAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "alertLevel": {
            "type": "string",
            "enum": [
              "push",
              "live",
              "closed",
              "none"
            ]
          },
          "acknowledgedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "claimCode": {
            "type": "string",
            "minLength": 4,
            "maxLength": 4
          },
          "readyRound": {
            "type": "integer"
          },
          "autoAlertsSent": {
            "type": "integer"
          },
          "manualAlertsSent": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "staff",
              "api",
              "connector"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readyAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "collectedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancelReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "ticketUrl": {
            "type": "string",
            "format": "uri"
          },
          "firstReadyAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expiredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "displayNumber",
          "number",
          "status",
          "version",
          "seq",
          "counterId",
          "note",
          "externalRef",
          "waitMinutes",
          "waitBaseAt",
          "alertLevel",
          "acknowledgedAt",
          "claimCode",
          "readyRound",
          "autoAlertsSent",
          "manualAlertsSent",
          "source",
          "createdAt",
          "readyAt",
          "collectedAt",
          "cancelReason",
          "ticketUrl",
          "firstReadyAt",
          "cancelledAt",
          "expiredAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/me": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "venue": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "timeZone": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "timeZone"
                      ]
                    },
                    "key": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "prefix": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "prefix"
                      ]
                    }
                  },
                  "required": [
                    "tenant",
                    "venue",
                    "key"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "externalRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "counter": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 280
                  },
                  "waitMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 240
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "received",
                      "preparing"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An open ticket with this externalRef already exists (FR-INT-05)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": false,
            "name": "externalRef",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "received",
                "preparing",
                "ready",
                "collected",
                "cancelled",
                "expired"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ticket"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{id}": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{id}/status": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "preparing",
                      "ready",
                      "collected",
                      "cancelled"
                    ]
                  },
                  "cancelReason": {
                    "type": "string",
                    "enum": [
                      "customer_left",
                      "refunded",
                      "out_of_stock",
                      "duplicate",
                      "mistake",
                      "other"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/by-external-ref/{externalRef}/status": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": true,
            "name": "externalRef",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "preparing",
                      "ready",
                      "collected",
                      "cancelled"
                    ]
                  },
                  "cancelReason": {
                    "type": "string",
                    "enum": [
                      "customer_left",
                      "refunded",
                      "out_of_stock",
                      "duplicate",
                      "mistake",
                      "other"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{id}/alert": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "202": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "accepted"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{id}/qr.png": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 128,
              "maximum": 1024,
              "default": 512
            },
            "required": false,
            "name": "size",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{id}/qr.svg": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Image",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
